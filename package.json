{
  "name": "primal-run-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "PRIMAL RUN offline prototype and GDevelop asset kit",
  "scripts": {
    "test": "npm run test:atlas-tools && npm run test:game && npm run test:kit",
    "test:game": "node tests/run-all.cjs",
    "test:unit": "node tests/run-all.cjs unit",
    "test:browser": "node tests/run-all.cjs browser",
    "test:kit": "node check_kit_directions.cjs && node check_kit_progression.cjs && node check_kit_files.cjs",
    "simulate:balance": "node tools/simulate_balance.cjs",
    "build:game": "python tools/build_game.py",
    "build:web": "node tools/build_web.cjs",
    "validate:game-sprites": "python tools/validate_game_sprites.py",
    "preview": "python -m http.server 8000",
    "validate:assets": "python PRIMAL_RUN_Prototype_Kit/tools/validate_kit.py",
    "validate:enemy-sprites": "python tools/validate_enemy_animations.py",
    "validate:ecology": "python tools/validate_ecology.py",
    "validate:corpses": "python tools/validate_corpses.py",
    "validate:enemy-full": "python tools/validate_enemy_full.py",
    "validate:player-full": "python tools/validate_player_full.py",
    "simulate:styles": "node tools/playstyle_sim.cjs",
    "simulate:quick": "node tools/playstyle_sim.cjs --quick",
    "build:lang": "python tools/i18n/build_lang.py",
    "validate:part-a": "python tools/validate_part_a.py && python tools/validate_water_corners.py && python tools/validate_injured_walk.py && python tools/validate_native_behavior.py",
    "validate:atlases": "python tools/validate_sprite_atlases.py",
    "validate:a6": "python tools/validate_a6.py",
    "test:atlas-tools": "python -m unittest discover -s tests -p test_sprite_atlases.py",
    "validate:animation-audit": "python tools/audit_species_animations.py",
    "validate:animation-polish": "python tools/validate_animation_polish.py",
    "test:rig": "node --test tests/rig-animator.test.cjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
